# 生产环境配置
#
# ⚠️ 这里【不要】写 NODE_ENV。
#    本文件原先有 NODE_ENV=production，每次构建都会打印一行：
#      "NODE_ENV=production is not supported in the .env file.
#       Only NODE_ENV=development is supported to create a development build."
#    Vite 只认 NODE_ENV=development（用于构建 development 产物），
#    写成 production 会被直接忽略 —— 也就是说那一行从来没有任何作用，
#    只是持续制造噪音，容易掩盖构建日志里真正的警告。
#    vite build 本身就是生产模式，不需要也无法从这里设置。
#    若确实要设置 process.env.NODE_ENV，应在 vite.config 里处理。
#
VITE_API_BASE_URL=/check

# ⚠️ 必须是【绝对的 ws(s):// 地址】，不能写 /check。
#
# 用法（src/composables/useCheckProgress.js、useMessageWebSocket.js）：
#     new WebSocket(`${wsBase}/ws/check-progress/${paperId}?token=...`)
# 原生 WebSocket 构造函数不接受相对路径，写 /check 会直接抛
#     SyntaxError: Failed to construct 'WebSocket': The URL '/check/ws/...' is invalid.
#
# 而且代码里写的是 `VITE_WS_BASE_URL || (wss|ws)://${window.location.host}`，
# /check 是【真值】—— 兜底永远不会触发。于是查重进度实时推送整个失效，
# 且报错只出现在浏览器控制台（不在网络面板），极易被误判成后端或网关问题。
#
# 这里只写到域名、不带路径，因为网关配置了：
#     location /ws/ { rewrite ^/ws/(.*)$ /check/ws/$1 break; proxy_pass $backend_upstream; }
# 即 /ws/xxx 会被转发到后端的 /check/ws/xxx，与后端 context-path 对齐。
#
# 本行原先误写为 VITE_WS_BASE_URL=/check，已修正。
VITE_WS_BASE_URL=wss://check-repeat-system.xyz

VITE_SYSTEM_NAME=论文查重管理系统
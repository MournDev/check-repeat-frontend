# ============================================================
# sudo 最小授权配置
#
# 安装：
#   install -m 0440 -o root -g root \
#     /opt/check-repeat-frontend/deploy/sudoers.deploy-frontend \
#     /etc/sudoers.d/deploy-frontend
#   visudo -cf /etc/sudoers.d/deploy-frontend     # 必须校验通过
#
# 作用：deploy 用户只能在【无密码】的情况下执行这一个脚本，
#       不能执行任意命令，也拿不到交互式 root shell。
#
# 注意 arguments 的写法：末尾的 "" 表示【不允许任何参数】。
#
#   这是刻意的收紧。commit SHA 不经命令行传入 —— 它由 sshd 放进环境变量
#   SSH_ORIGINAL_COMMAND，脚本自行读取（见 authorized_keys 的 command=）。
#   因此命令行上不该有任何参数。
#
#   ⚠️ 不要写成省略参数的形式（止于 /usr/local/bin/deploy-frontend.sh）。
#   sudoers 对省略参数的命令默认允许【任意参数】，那会让 command= 的
#   限制形同虚设。
#
#   root 在宿主机上手工指定提交时不经过 sudo，不受本文件约束。
# ============================================================

# sudo 默认清空环境变量。SSH_ORIGINAL_COMMAND 是脚本取 commit SHA 的
# 唯一来源，必须显式保留，否则脚本会一直退回「部署 origin/master HEAD」，
# 表现为 Jenkins 传什么提交都无效。只对 deploy 用户放开，不做全局设置。
Defaults:deploy env_keep += "SSH_ORIGINAL_COMMAND"

deploy ALL=(root) NOPASSWD: /usr/local/bin/deploy-frontend.sh ""
